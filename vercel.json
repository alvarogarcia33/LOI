{
  "functions": {
    "api/*.js": {
      "includeFiles": "conocimiento/**"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/metaacademy/index.html"
    },
    {
      "source": "/jugadores",
      "destination": "/metaacademy/jugadores.html"
    },
    {
      "source": "/jugadores.html",
      "destination": "/metaacademy/jugadores.html"
    },
    {
      "source": "/maestros",
      "destination": "/metaacademy/maestros.html"
    },
    {
      "source": "/maestros.html",
      "destination": "/metaacademy/maestros.html"
    },
    {
      "source": "/creadores",
      "destination": "/metaacademy/creadores.html"
    },
    {
      "source": "/creadores.html",
      "destination": "/metaacademy/creadores.html"
    },
    {
      "source": "/styles.css",
      "destination": "/metaacademy/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/metaacademy/app.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/metaacademy/assets/$1"
    }
  ]
}
